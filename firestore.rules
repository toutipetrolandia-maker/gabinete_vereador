rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // 1. GLOBAL HELPERS
    // ==========================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }
    
    // Internal user check: must be active and have a valid cabinet role
    function isCabinetMember() {
      let data = getUserData();
      return isSignedIn() && data.ativo == true && data.role in ['admin', 'vereador', 'assessor'];
    }
    
    function isAdmin() {
      return hasRole('admin');
    }
    
    function isVereador() {
      return hasRole('vereador');
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ==========================================
    // 2. DEFAULT DENY
    // ==========================================
    
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // 3. COLLECTION RULES
    // ==========================================

    // Health check Document
    match /_connection_test/ping {
      allow get: if isSignedIn();
    }

    // USER PROFILES
    match /users/{userId} {
      // Users can read their own profile. Admins and Vereadores can read all.
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin() || isVereador());
      allow list: if isAdmin() || isVereador();
      
      function isValidUser(data) {
        return data.nome is string && data.nome.size() <= 100 &&
               data.email is string && data.email == request.auth.token.email &&
               data.role in ['admin', 'assessor', 'vereador', 'consulta'] &&
               data.ativo is bool;
      }

      // Initial profile creation (via useAuth hook)
      allow create: if isEmailVerified() && isOwner(userId) && isValidUser(incoming());
      
      allow update: if isEmailVerified() && (
        // Only admin can change roles or activation status
        (isAdmin() && incoming().email == existing().email) ||
        // User can update their own status (online/offline)
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'last_seen']))
      );

      allow delete: if isAdmin() || isVereador();
    }

    // ATENDIMENTOS (GENERIC)
    match /atendimentos/{id} {
      allow read: if isCabinetMember() || hasRole('consulta');
      
      function isValidAtendimento(data) {
        return data.nome_completo is string && data.nome_completo.size() <= 150 &&
               data.usuario_id == request.auth.uid &&
               data.status in ['Novo', 'Em Andamento', 'Concluído', 'Cancelado', 'Pendente', 'Encaminhado', 'Em andamento'] &&
               data.prioridade in ['Baixa', 'Média', 'Alta'];
      }

      allow create: if isCabinetMember() && isEmailVerified() && isValidAtendimento(incoming()) && incoming().created_at == request.time;
      
      allow update: if isCabinetMember() && isEmailVerified() && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updated_at']) && incoming().updated_at == request.time) ||
        (isAdmin()) ||
        (incoming().usuario_id == existing().usuario_id && incoming().updated_at == request.time)
      );
      
      allow delete: if isAdmin();
    }

    // ATENDIMENTOS MÉDICOS (Sensitive PII)
    match /atendimentos_medicos/{id} {
      // Restricted to Cabinet Members only (No Consulta)
      allow read: if isCabinetMember();
      
      function isValidAtendimentoMedico(data) {
        return data.nome_completo is string && data.nome_completo.size() <= 150 &&
               data.usuario_id == request.auth.uid;
      }

      allow create: if isCabinetMember() && isEmailVerified() && isValidAtendimentoMedico(incoming()) && incoming().created_at == request.time;
      allow update: if isCabinetMember() && isEmailVerified() && (
        isAdmin() || 
        (incoming().usuario_id == existing().usuario_id && incoming().updated_at == request.time)
      );
      allow delete: if isAdmin();
    }

    // AGENDA VEREADOR
    match /agenda_vereador/{id} {
      allow read: if isSignedIn();
      allow create, update: if isCabinetMember() && isEmailVerified();
      allow delete: if isAdmin() || (isVereador() && isEmailVerified());
    }

    // SUGESTÕES
    match /sugestoes/{id} {
      allow read: if isCabinetMember();
      allow create, update: if isCabinetMember() && isEmailVerified();
      allow delete: if isAdmin();
    }

    // MALOTES
    match /malotes/{id} {
      allow read: if isCabinetMember();
      allow create, update: if isCabinetMember() && isEmailVerified();
      allow delete: if isAdmin();
    }
    
    // DEMANDAS PARLAMENTARES
    match /demandas_parlamentares/{id} {
      allow read: if isCabinetMember();
      allow create, update: if isCabinetMember() && isEmailVerified();
      allow delete: if isAdmin();
    }

    // APP SETTINGS
    match /app_settings/{docId} {
      allow read: if isSignedIn();
      allow update: if isEmailVerified() && (isAdmin() || isVereador());
      allow create: if isAdmin();
    }

    // AUDIT LOGS (IMMUTABLE & RESTRICTED)
    match /logs/{id} {
      allow read: if isCabinetMember() && (isAdmin() || isVereador());
      allow create: if isEmailVerified();
      allow update, delete: if false;
    }
  }
}
