rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // 1. GLOBAL HELPERS
    // ==========================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }
    
    // Internal user check: must be active and have a valid cabinet role
    function isCabinetMember() {
      let docPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && 
             exists(docPath) && 
             (get(docPath).data.ativo == true || get(docPath).data.role == 'admin') && 
             get(docPath).data.role in ['admin', 'vereador', 'assessor', 'secretaria_parlamentar'];
    }
    
    function isAdmin() {
      let docPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(docPath) && get(docPath).data.role == 'admin';
    }
    
    function isVereador() {
      let docPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(docPath) && get(docPath).data.role == 'vereador';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ==========================================
    // 2. DEFAULT DENY
    // ==========================================
    
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // 3. COLLECTION RULES
    // ==========================================

    // Health check Document
    match /_connection_test/ping {
      allow get: if isSignedIn();
    }

    // USER PROFILES
    match /users/{userId} {
      // Users can read their own profile. Admins and Vereadores can read all.
      // Allow public 'get' for username-to-email resolution in Login.tsx
      allow get: if true;
      allow list: if isAdmin() || isVereador();
      
      function isValidUser(data) {
        return data.nome is string && data.nome.size() <= 100 &&
               data.role in ['admin', 'assessor', 'vereador', 'consulta', 'secretaria_parlamentar'];
      }

      // Initial profile creation (via useAuth hook)
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidUser(incoming());
      
      allow update: if isSignedIn() && (
        // Only admin can change roles or activation status
        (isAdmin()) ||
        // User can update their own status (online/offline)
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'last_seen', 'primeiro_acesso_concluido', 'status_oculos', 'updated_at']))
      );

      allow delete: if isAdmin() || isVereador();
    }

    // ATENDIMENTOS (GENERIC)
    match /atendimentos/{id} {
      allow read: if isCabinetMember() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'consulta');
      
      function isValidAtendimento(data) {
        return data.nome_completo is string && data.nome_completo.size() <= 150 &&
               (data.usuario_id == request.auth.uid || data.assessor_id == request.auth.uid || !('usuario_id' in data)) &&
               data.status in ['Novo', 'Em Andamento', 'Concluído', 'Cancelado', 'Pendente', 'Encaminhado', 'Em andamento'] &&
               data.prioridade in ['Baixa', 'Média', 'Alta'];
      }

      allow create: if isCabinetMember() && isValidAtendimento(incoming()) && (incoming().created_at == request.time || !('created_at' in incoming()));
      
      allow update: if isCabinetMember() && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updated_at']) && (incoming().updated_at == request.time || !('updated_at' in incoming()))) ||
        (isAdmin()) ||
        ((incoming().usuario_id == existing().usuario_id || incoming().assessor_id == existing().assessor_id) && (incoming().updated_at == request.time || !('updated_at' in incoming())))
      );
      
      allow delete: if isAdmin();
    }

    // ATENDIMENTOS MÉDICOS (Sensitive PII)
    match /atendimentos_medicos/{id} {
      // Restricted to Cabinet Members only (No Consulta)
      allow read: if isCabinetMember();
      
      function isValidAtendimentoMedico(data) {
        return data.nome_completo is string && data.nome_completo.size() <= 150 &&
               (data.usuario_id == request.auth.uid || data.assessor_id == request.auth.uid || !('usuario_id' in data));
      }

      allow create: if isCabinetMember() && isValidAtendimentoMedico(incoming()) && (incoming().created_at == request.time || !('created_at' in incoming()));
      allow update: if isCabinetMember() && (
        isAdmin() || 
        ((incoming().usuario_id == existing().usuario_id || incoming().assessor_id == existing().assessor_id) && (incoming().updated_at == request.time || !('updated_at' in incoming())))
      );
      allow delete: if isAdmin();
    }

    // AGENDA VEREADOR
    match /agenda_vereador/{id} {
      allow read: if isSignedIn();
      allow create, update: if isCabinetMember();
      allow delete: if isAdmin() || isVereador();
    }

    // SUGESTÕES
    match /sugestoes/{id} {
      allow read: if isCabinetMember();
      allow create, update: if isCabinetMember();
      allow delete: if isAdmin();
    }

    // MALOTES
    match /malotes/{id} {
      allow read: if isCabinetMember();
      allow create, update: if isCabinetMember();
      allow delete: if isAdmin();
    }
    
    // DEMANDAS PARLAMENTARES
    match /demandas_parlamentares/{id} {
      allow read: if isCabinetMember();
      allow create, update: if isCabinetMember();
      allow delete: if isAdmin();
    }

    // APP SETTINGS
    match /app_settings/{docId} {
      allow read: if isSignedIn();
      allow update: if isAdmin() || isVereador();
      allow create: if isAdmin();
    }

    // AUDIT LOGS (IMMUTABLE & RESTRICTED)
    match /logs/{id} {
      allow read: if isCabinetMember() && (isAdmin() || isVereador());
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
