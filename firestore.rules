rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // 1. GLOBAL HELPERS
    // ==========================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      let docPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(docPath) && (get(docPath).data.role == 'admin' || get(docPath).data.role == 'superadmin' || get(docPath).data.role == 'secretaria_parlamentar');
    }
    
    function isSuper() {
      let docPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && (
        request.auth.token.email == 'cleciotecnologia@gmail.com' || 
        request.auth.token.email == 'toutipetrolandia@gmail.com' ||
        (exists(docPath) && get(docPath).data.role == 'superadmin')
      );
    }

    function isCabinetMember() {
      let docPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && 
             exists(docPath) && 
             (get(docPath).data.ativo == true || get(docPath).data.role == 'admin' || get(docPath).data.role == 'superadmin' || get(docPath).data.role == 'secretaria_parlamentar') && 
             get(docPath).data.role in ['superadmin', 'admin', 'vereador', 'assessor', 'secretaria_parlamentar', 'consulta'];
    }

    function belongsToCabinet(cabinetId) {
      return isSuper() || (isCabinetMember() && getUserData().cabinetId == cabinetId);
    }
    
    function dataBelongsToUserCabinet() {
      return isSuper() || (isCabinetMember() && request.resource.data.cabinetId == getUserData().cabinetId);
    }

    function resourceBelongsToUserCabinet() {
      return isSuper() || (isCabinetMember() && resource.data.cabinetId == getUserData().cabinetId);
    }

    function isVereador() {
      let docPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(docPath) && (get(docPath).data.role == 'vereador' || get(docPath).data.role == 'superadmin' || get(docPath).data.role == 'admin' || get(docPath).data.role == 'secretaria_parlamentar');
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || isSuper());
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ==========================================
    // 2. DEFAULT DENY
    // ==========================================
    
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // 3. COLLECTION RULES
    // ==========================================
    
    // Health check Document
    match /_connection_test/ping {
      allow get: if isSignedIn();
    }

    // CABINETS
    match /cabinets/{cabinetId} {
      // Allow public read to facilitate multitenancy detection (subdomains/domains)
      allow read: if true; 
      allow write: if isSuper() || (belongsToCabinet(cabinetId) && isAdmin());
    }


    match /users/{userId} {
      allow get: if true;
      allow list: if isSuper() || (isCabinetMember() && resourceBelongsToUserCabinet() && (isAdmin() || isVereador()));
      
      function isValidUser(data) {
        return data.nome is string && data.nome.size() <= 100 &&
               data.role in ['superadmin', 'admin', 'assessor', 'vereador', 'consulta', 'secretaria_parlamentar'];
      }

      allow create: if isSignedIn() && (isOwner(userId) || isSuper()) && isValidUser(incoming());
      
      allow update: if isSignedIn() && (
        isSuper() || (isAdmin() && resourceBelongsToUserCabinet()) ||
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'last_seen', 'primeiro_acesso_concluido', 'status_oculos', 'updated_at']))
      );

      allow delete: if isSuper();
    }

    // ATENDIMENTOS
    match /atendimentos/{id} {
      allow read: if resourceBelongsToUserCabinet();
      
      function isValidAtendimento(data) {
        return data.nome_completo is string && data.nome_completo.size() <= 150 &&
               data.cabinetId is string;
      }

      allow create: if isCabinetMember() && dataBelongsToUserCabinet() && isValidAtendimento(incoming());
      allow update: if isCabinetMember() && resourceBelongsToUserCabinet() && (isSuper() || isAdmin() || existing().usuario_id == request.auth.uid);
      allow delete: if isSuper() || (isAdmin() && resourceBelongsToUserCabinet());
    }

    // ATENDIMENTOS MÉDICOS
    match /atendimentos_medicos/{id} {
      allow read: if resourceBelongsToUserCabinet();
      
      function isValidAtendimentoMedico(data) {
        return data.nome_completo is string && data.nome_completo.size() <= 150 &&
               data.cabinetId is string;
      }

      allow create: if isCabinetMember() && dataBelongsToUserCabinet() && isValidAtendimentoMedico(incoming());
      allow update: if isCabinetMember() && resourceBelongsToUserCabinet() && (isSuper() || isAdmin() || existing().usuario_id == request.auth.uid);
      allow delete: if isSuper() || (isAdmin() && resourceBelongsToUserCabinet());
    }

    // AGENDA VEREADOR
    match /agenda_vereador/{id} {
      allow read: if resourceBelongsToUserCabinet();
      allow create: if isCabinetMember() && dataBelongsToUserCabinet();
      allow update: if isCabinetMember() && resourceBelongsToUserCabinet() && dataBelongsToUserCabinet();
      allow delete: if isSuper() || (isAdmin() && resourceBelongsToUserCabinet());
    }

    // SUGESTÕES
    match /sugestoes/{id} {
      allow read: if resourceBelongsToUserCabinet();
      allow create: if isCabinetMember() && dataBelongsToUserCabinet();
      allow update: if isCabinetMember() && resourceBelongsToUserCabinet() && dataBelongsToUserCabinet();
      allow delete: if isSuper() || (isAdmin() && resourceBelongsToUserCabinet());
    }

    // MALOTES
    match /malotes/{id} {
      allow read: if resourceBelongsToUserCabinet();
      allow create: if isCabinetMember() && dataBelongsToUserCabinet();
      allow update: if isCabinetMember() && resourceBelongsToUserCabinet() && dataBelongsToUserCabinet();
      allow delete: if isSuper() || (isAdmin() && resourceBelongsToUserCabinet());
    }
    
    // AUXÍLIO SOCIAL
    match /auxilio_social/{id} {
      allow read: if resourceBelongsToUserCabinet();
      
      function isValidAuxilioSocial(data) {
        return data.beneficiado_nome is string && data.beneficiado_nome.size() <= 150 &&
               data.cabinetId is string &&
               data.tipo_beneficio is string;
      }
      
      allow create: if isCabinetMember() && dataBelongsToUserCabinet() && isValidAuxilioSocial(incoming());
      allow update: if isCabinetMember() && resourceBelongsToUserCabinet() && dataBelongsToUserCabinet() && isValidAuxilioSocial(incoming());
      allow delete: if isCabinetMember() && resourceBelongsToUserCabinet();
    }

    // AUXÍLIO ESTOQUE
    match /auxilio_estoque/{id} {
      allow read: if resourceBelongsToUserCabinet();
      
      function isValidAuxilioEstoque(data) {
        return data.nome is string && data.nome.size() <= 150 &&
               data.cabinetId is string &&
               data.tipo_beneficio is string;
      }
      
      allow create: if isCabinetMember() && dataBelongsToUserCabinet() && isValidAuxilioEstoque(incoming());
      allow update: if isCabinetMember() && resourceBelongsToUserCabinet() && dataBelongsToUserCabinet() && isValidAuxilioEstoque(incoming());
      allow delete: if isCabinetMember() && resourceBelongsToUserCabinet();
    }

    // INDICAÇÕES CARGOS
    match /indicacoes_cargos/{id} {
      allow read: if resourceBelongsToUserCabinet();
      
      function isValidIndicacaoCargo(data) {
        return data.indicado_nome is string && data.indicado_nome.size() <= 150 &&
               data.cabinetId is string &&
               data.cargo_pretendido is string;
      }
      
      allow create: if isCabinetMember() && dataBelongsToUserCabinet() && isValidIndicacaoCargo(incoming());
      allow update: if isCabinetMember() && resourceBelongsToUserCabinet() && dataBelongsToUserCabinet() && isValidIndicacaoCargo(incoming());
      allow delete: if isCabinetMember() && resourceBelongsToUserCabinet();
    }

    // DEMANDAS PARLAMENTARES
    match /demandas_parlamentares/{id} {
      allow read: if resourceBelongsToUserCabinet();
      allow create: if isCabinetMember() && dataBelongsToUserCabinet();
      allow update: if isCabinetMember() && resourceBelongsToUserCabinet() && dataBelongsToUserCabinet();
      allow delete: if isSuper() || (isAdmin() && resourceBelongsToUserCabinet());
    }

    // AUDIT LOGS
    match /logs/{id} {
      allow read: if isSuper() || (isCabinetMember() && resourceBelongsToUserCabinet() && (isAdmin() || isVereador()));
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
