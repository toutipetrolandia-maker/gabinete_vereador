{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "System user profiles, roles and online status",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "atendente", "vereador", "consulta"] },
        "ativo": { "type": "boolean" },
        "status": { "type": "string", "enum": ["online", "offline"] },
        "last_seen": { "type": "string", "format": "date-time" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["nome", "email", "role", "ativo"]
    },
    "Atendimento": {
      "title": "Atendimento Geral",
      "description": "General parliamentary assistance records",
      "type": "object",
      "properties": {
        "nome_completo": { "type": "string" },
        "cpf": { "type": "string" },
        "whatsapp": { "type": "string" },
        "protocolo": { "type": "string" },
        "bairro": { "type": "string" },
        "zona_rural": { "type": "boolean" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "tipo_atendimento": { "type": "string", "enum": ["Geral", "Médico", "Demanda", "Sugestão"] },
        "status": { "type": "string", "enum": ["Novo", "Em Andamento", "Concluído", "Cancelado"] },
        "prioridade": { "type": "string", "enum": ["Baixa", "Média", "Alta"] },
        "descricao": { "type": "string" },
        "usuario_id": { "type": "string" },
        "usuario_nome": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["nome_completo", "tipo_atendimento", "status", "prioridade"]
    },
    "AtendimentoMedico": {
      "title": "Atendimento Médico",
      "description": "Health specific appointments",
      "type": "object",
      "properties": {
        "nome_completo": { "type": "string" },
        "datanascimento": { "type": "string" },
        "cpf": { "type": "string" },
        "telefone": { "type": "string" },
        "endereco": { "type": "string" },
        "cartao_sus": { "type": "string" },
        "bairro": { "type": "string" },
        "zona_rural": { "type": "boolean" },
        "unidade_saude": { "type": "string" },
        "especialidade": { "type": "string" },
        "status": { "type": "string" },
        "prioridade": { "type": "string" },
        "descricao_problema": { "type": "string" },
        "necessita_exame": { "type": "boolean" },
        "lembrete_exame": { "type": "string" },
        "usuario_id": { "type": "string" },
        "usuario_nome": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["nome_completo", "status", "prioridade"]
    },
    "Agenda": {
      "title": "Agenda do Vereador",
      "description": "Councilor official schedule",
      "type": "object",
      "properties": {
        "titulo": { "type": "string" },
        "tipo": { "type": "string", "enum": ["Compromisso", "Sessão", "Gabinete", "Viagem", "Outro"] },
        "data": { "type": "string" },
        "hora_inicio": { "type": "string" },
        "hora_fim": { "type": "string" },
        "local": { "type": "string" },
        "contato_nome": { "type": "string" },
        "contato_telefone": { "type": "string" },
        "lembrete_data": { "type": "string" },
        "lembrete_hora": { "type": "string" },
        "descricao": { "type": "string" },
        "usuario_id": { "type": "string" },
        "usuario_nome": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "Sugestao": {
      "title": "Sugestão / Ouvidoria",
      "description": "Public feedback",
      "type": "object",
      "properties": {
        "nome_completo": { "type": "string" },
        "telefone": { "type": "string" },
        "email": { "type": "string" },
        "sugestao": { "type": "string" },
        "status": { "type": "string" },
        "lembrete": { "type": "string" },
        "usuario_id": { "type": "string" },
        "usuario_nome": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "AuditLog": {
      "title": "Log de Auditoria",
      "description": "Immutable audit trail",
      "type": "object",
      "properties": {
        "usuario_id": { "type": "string" },
        "usuario_nome": { "type": "string" },
        "acao": { "type": "string" },
        "colecao": { "type": "string" },
        "documento_id": { "type": "string" },
        "dados_anteriores": { "type": "object" },
        "dados_novos": { "type": "object" },
        "criado_em": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "User profiles" },
    "/atendimentos/{id}": { "schema": "Atendimento", "description": "General records" },
    "/atendimentos_medicos/{id}": { "schema": "AtendimentoMedico", "description": "Medical records" },
    "/agenda_vereador/{id}": { "schema": "Agenda", "description": "Schedule" },
    "/sugestoes/{id}": { "schema": "Sugestao", "description": "Feedback" },
    "/logs/{id}": { "schema": "AuditLog", "description": "Audit trails" },
    "/app_settings/global": { "schema": "object", "description": "Global config" }
  }
}
