{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "System user profiles, roles and online status within a cabinet",
      "type": "object",
      "properties": {
        "cabinetId": { "type": "string" },
        "nome": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["superadmin", "admin", "assessor", "vereador", "consulta", "secretaria_parlamentar", "suporte_ti"] },
        "ativo": { "type": "boolean" },
        "status": { "type": "string", "enum": ["online", "offline"] },
        "last_seen": { "type": "string", "format": "date-time" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["nome", "email", "role", "ativo", "cabinetId"]
    },
    "Cabinet": {
      "title": "Cabinet (Tenant)",
      "description": "Organization/Cabinet settings in the SaaS platform",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "custom_domain": { "type": "string" },
        "subdomain": { "type": "string" },
        "vereador_nome": { "type": "string" },
        "vereador_photo": { "type": "string" },
        "perfil_link": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended", "trial"] },
        "plan": { "type": "string", "enum": ["basic", "pro", "enterprise"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "status"]
    },
    "Atendimento": {
      "title": "Atendimento Geral",
      "description": "General parliamentary assistance records",
      "type": "object",
      "properties": {
        "cabinetId": { "type": "string" },
        "nome_completo": { "type": "string" },
        "cpf": { "type": "string" },
        "whatsapp": { "type": "string" },
        "protocolo": { "type": "string" },
        "bairro": { "type": "string" },
        "zona_rural": { "type": "boolean" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "tipo_atendimento": { "type": "string", "enum": ["Geral", "Médico", "Demanda", "Sugestão"] },
        "status": { "type": "string", "enum": ["Novo", "Em Andamento", "Concluído", "Cancelado"] },
        "prioridade": { "type": "string", "enum": ["Baixa", "Média", "Alta"] },
        "descricao": { "type": "string" },
        "usuario_id": { "type": "string" },
        "usuario_nome": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["cabinetId", "nome_completo", "tipo_atendimento", "status", "prioridade"]
    },
    "AtendimentoMedico": {
      "title": "Atendimento Médico",
      "description": "Health specific appointments",
      "type": "object",
      "properties": {
        "cabinetId": { "type": "string" },
        "nome_completo": { "type": "string" },
        "datanascimento": { "type": "string" },
        "cpf": { "type": "string" },
        "telefone": { "type": "string" },
        "endereco": { "type": "string" },
        "cartao_sus": { "type": "string" },
        "bairro": { "type": "string" },
        "zona_rural": { "type": "boolean" },
        "unidade_saude": { "type": "string" },
        "especialidade": { "type": "string" },
        "status": { "type": "string" },
        "prioridade": { "type": "string" },
        "descricao_problema": { "type": "string" },
        "necessita_exame": { "type": "boolean" },
        "lembrete_exame": { "type": "string" },
        "usuario_id": { "type": "string" },
        "usuario_nome": { "type": "string" },
        "satisfacao_nivel": { "type": "number", "minimum": 1, "maximum": 5 },
        "satisfacao_comentario": { "type": "string" },
        "bem_atendido": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["cabinetId", "nome_completo", "status", "prioridade"]
    },
    "Agenda": {
      "title": "Agenda do Vereador",
      "description": "Councilor official schedule",
      "type": "object",
      "properties": {
        "cabinetId": { "type": "string" },
        "titulo": { "type": "string" },
        "tipo": { "type": "string", "enum": ["Compromisso", "Sessão", "Gabinete", "Viagem", "Outro"] },
        "data": { "type": "string" },
        "hora_inicio": { "type": "string" },
        "hora_fim": { "type": "string" },
        "local": { "type": "string" },
        "contato_nome": { "type": "string" },
        "contato_telefone": { "type": "string" },
        "lembrete_data": { "type": "string" },
        "lembrete_hora": { "type": "string" },
        "descricao": { "type": "string" },
        "usuario_id": { "type": "string" },
        "usuario_nome": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["cabinetId"]
    },
    "Sugestao": {
      "title": "Sugestão / Ouvidoria",
      "description": "Public feedback",
      "type": "object",
      "properties": {
        "cabinetId": { "type": "string" },
        "nome_completo": { "type": "string" },
        "telefone": { "type": "string" },
        "email": { "type": "string" },
        "sugestao": { "type": "string" },
        "status": { "type": "string" },
        "lembrete": { "type": "string" },
        "usuario_id": { "type": "string" },
        "usuario_nome": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["cabinetId"]
    },
    "AuditLog": {
      "title": "Log de Auditoria",
      "description": "Immutable audit trail",
      "type": "object",
      "properties": {
        "cabinetId": { "type": "string" },
        "usuario_id": { "type": "string" },
        "usuario_nome": { "type": "string" },
        "acao": { "type": "string" },
        "colecao": { "type": "string" },
        "documento_id": { "type": "string" },
        "dados_anteriores": { "type": "object" },
        "dados_novos": { "type": "object" },
        "criado_em": { "type": "string", "format": "date-time" }
      },
      "required": ["cabinetId"]
    },
    "AuxilioSocial": {
      "title": "Auxílio Social",
      "description": "Control of social benefits like food baskets, medicine, and diapers",
      "type": "object",
      "properties": {
        "cabinetId": { "type": "string" },
        "beneficiado_nome": { "type": "string" },
        "beneficiado_telefone": { "type": "string" },
        "beneficiado_cpf": { "type": "string" },
        "tipo_beneficio": { "type": "string", "enum": ["Cesta Básica", "Remédio", "Fralda", "Kit Higiene", "Material Escolar", "Outro"] },
        "quantidade": { "type": "number" },
        "status": { "type": "string", "enum": ["Pendente", "Em Rota", "Entregue", "Cancelado"] },
        "data_entrega_prevista": { "type": "string" },
        "data_entrega_realizada": { "type": "string", "format": "date-time" },
        "entregue_por_nome": { "type": "string" },
        "observacoes": { "type": "string" },
        "usuario_id": { "type": "string" },
        "usuario_nome": { "type": "string" },
        "item_estoque_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["cabinetId", "beneficiado_nome", "tipo_beneficio", "status"]
    },
    "AuxilioEstoque": {
      "title": "Controle de Estoque de Auxílio Social",
      "description": "Inventory control for social benefits",
      "type": "object",
      "properties": {
        "cabinetId": { "type": "string" },
        "nome": { "type": "string" },
        "tipo_beneficio": { "type": "string", "enum": ["Cesta Básica", "Remédio", "Fralda", "Kit Higiene", "Material Escolar", "Outro"] },
        "quantidade_atual": { "type": "number" },
        "quantidade_minima": { "type": "number" },
        "observacoes": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["cabinetId", "nome", "tipo_beneficio", "quantidade_atual", "quantidade_minima"]
    },
    "IndicacaoCargo": {
      "title": "Indicação de Cargo",
      "description": "Control of political nominations for trust positions",
      "type": "object",
      "properties": {
        "cabinetId": { "type": "string" },
        "indicado_nome": { "type": "string" },
        "indicado_cpf": { "type": "string" },
        "indicado_telefone": { "type": "string" },
        "cargo_pretendido": { "type": "string" },
        "orgao_destino": { "type": "string" },
        "status": { "type": "string", "enum": ["Pendente", "Em Análise", "Nomeado", "Exonerado", "Rejeitado"] },
        "data_indicacao": { "type": "string" },
        "data_nomeacao": { "type": "string" },
        "qualificacao": { "type": "string" },
        "observacoes": { "type": "string" },
        "usuario_id": { "type": "string" },
        "usuario_nome": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["cabinetId", "indicado_nome", "cargo_pretendido", "status"]
    },
    "DemandaParlamentar": {
      "title": "Demanda Parlamentar",
      "description": "Control of official requests, requirements and indications assigned to assessors",
      "type": "object",
      "properties": {
        "cabinetId": { "type": "string" },
        "protocolo": { "type": "string" },
        "assunto": { "type": "string" },
        "solicitante_nome": { "type": "string" },
        "solicitante_telefone": { "type": "string" },
        "orgao_responsavel": { "type": "string" },
        "prioridade": { "type": "string", "enum": ["Baixa", "Média", "Alta"] },
        "status": { "type": "string", "enum": ["Pendente", "Encaminhado", "Concluído"] },
        "descricao": { "type": "string" },
        "assessor_id": { "type": "string" },
        "assessor_nome": { "type": "string" },
        "attachments": { "type": "array" },
        "usuario_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["cabinetId", "assunto", "status"]
    }
  },
  "firestore": {
    "/cabinets/{cabinetId}": { "schema": "Cabinet", "description": "Cabinet settings" },
    "/users/{userId}": { "schema": "User", "description": "User profiles" },
    "/atendimentos/{id}": { "schema": "Atendimento", "description": "General records" },
    "/atendimentos_medicos/{id}": { "schema": "AtendimentoMedico", "description": "Medical records" },
    "/agenda_vereador/{id}": { "schema": "Agenda", "description": "Schedule" },
    "/sugestoes/{id}": { "schema": "Sugestao", "description": "Feedback" },
    "/logs/{id}": { "schema": "AuditLog", "description": "Audit trails" },
    "/auxilio_social/{id}": { "schema": "AuxilioSocial", "description": "Social assistance records" },
    "/auxilio_estoque/{id}": { "schema": "AuxilioEstoque", "description": "Stock inventory records" },
    "/indicacoes_cargos/{id}": { "schema": "IndicacaoCargo", "description": "Position nomination records" },
    "/demandas_parlamentares/{id}": { "schema": "DemandaParlamentar", "description": "Parliamentary official requests" }
  }
}
